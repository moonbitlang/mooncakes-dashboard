{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "github-repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "link": { "type": "string", "format": "uri" },
          "branch": { "type": "string" },
          "running_os": { "type": "array", "items": { "type": "string", "enum": ["linux", "macos", "windows"] } },
          "running_backend": {
            "type": "array",
            "items": { "type": "string", "enum": ["wasm", "wasm-gc", "js", "native"] }
          }
        },
        "required": ["name", "link", "branch"],
        "additionalProperties": false
      }
    },
    "mooncakes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "running_os": { "type": "array", "items": { "type": "string", "enum": ["linux", "macos", "windows"] } },
          "running_backend": {
            "type": "array",
            "items": { "type": "string", "enum": ["wasm", "wasm-gc", "js", "native"] }
          }
        },
        "required": ["name", "version"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
